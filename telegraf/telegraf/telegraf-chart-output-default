                    {{- if eq $val $xval }}
        {{ $val | int64 }}.0
                    {{- else }}
        {{ $val | float64 }}
                    {{- end }}
                  {{- else }}
        {{ $val | int64 }}
                  {{- end }}
                {{- end }}
                {{- if ne $i $numOut -}}
        ,
                {{- end -}}
              {{- end }}
